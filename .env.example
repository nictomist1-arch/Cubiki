# Порт сервера (Render использует PORT=10000)
PORT=3000

# Секрет для JWT (обязательно смените в продакшене!)
JWT_SECRET=your-super-secret-key-min-32-chars

# MongoDB Atlas (продакшен). Без MONGO_URI — локальный файл data/users.json
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/cubiki

# production | development
NODE_ENV=development
